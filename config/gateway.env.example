DEBUG=true
LOG_LEVEL=info

SYSTEM_PORT=3003

HTTP_PORT=
GRPC_PORT=

CORE_GRPC_ADDRESS=localhost:5050

TRUSTED_PROXY_ADDRESSES=

# memory for responses of endpoints with server cache; expired ones are swept
CACHE_MAX_SIZE_MB=256
CACHE_SWEEP_INTERVAL=30s

# prometheus metrics on :SYSTEM_PORT/metrics
WITH_METRICS=false
METRICS_NAMESPACE=company
