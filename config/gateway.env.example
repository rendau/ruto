DEBUG=true
LOG_LEVEL=info

SYSTEM_PORT=3003

HTTP_PORT=
GRPC_PORT=

CORE_GRPC_ADDRESS=localhost:5050

TRUSTED_PROXY_ADDRESSES=

# memory for responses of endpoints with server cache; expired ones are swept
CACHE_MAX_SIZE_MB=256
CACHE_SWEEP_INTERVAL=30s

# prometheus metrics on :SYSTEM_PORT/metrics
WITH_METRICS=false
METRICS_NAMESPACE=company

# browser bundle of the JS SDK, served at /_auth/ruto-auth.js (sdk/js, `make build-sdk`);
# empty: ./sdk-dist/ruto-auth.iife.js (docker image) or ./sdk/js/dist/ruto-auth.iife.js (repo)
SDK_JS_FILE=
