{
  "realm": "corp",
  "enabled": true,
  "accessTokenLifespan": 60,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [{"name": "auditor"}],
    "client": {"shop": [{"name": "manager"}]}
  },
  "clients": [
    {
      "clientId": "ruto",
      "enabled": true,
      "publicClient": false,
      "secret": "ruto-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": ["http://localhost:8088/_auth/corp/callback"],
      "attributes": {"post.logout.redirect.uris": "http://localhost:5181/*##http://localhost:5182/*##http://localhost:8088/*"},
      "defaultClientScopes": ["profile", "email", "roles", "basic"],
      "protocolMappers": [
        {"name": "tenant_id", "protocol": "openid-connect", "protocolMapper": "oidc-usermodel-attribute-mapper",
         "config": {"user.attribute": "tenant_id", "claim.name": "tenant_id", "jsonType.label": "String",
                    "access.token.claim": "true", "id.token.claim": "true", "userinfo.token.claim": "true"}}
      ]
    },
    {
      "clientId": "orders-client",
      "enabled": true,
      "publicClient": false,
      "secret": "orders-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": ["http://localhost:8088/_auth/corp/orders/callback"],
      "attributes": {"post.logout.redirect.uris": "http://localhost:5182/*##http://localhost:8088/*"},
      "defaultClientScopes": ["profile", "email", "roles", "basic"]
    },
    {
      "clientId": "shop",
      "enabled": true,
      "bearerOnly": true,
      "standardFlowEnabled": false
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@example.test",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Tester",
      "attributes": {"tenant_id": ["t-42"]},
      "credentials": [{"type": "password", "value": "alice-pass", "temporary": false}],
      "realmRoles": ["auditor"],
      "clientRoles": {"shop": ["manager"]}
    },
    {
      "username": "bob",
      "enabled": true,
      "email": "bob@example.test",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "NoRoles",
      "credentials": [{"type": "password", "value": "bob-pass", "temporary": false}]
    }
  ]
}
