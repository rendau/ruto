DEBUG=true
LOG_LEVEL=info

SYSTEM_PORT=3003

GRPC_PORT=5050
HTTP_PORT=80
HTTP_CORS=true

ADMIN_JWT_SECRET=change_me_secret

PG_DSN="postgres://user:password@localhost:5432/database?sslmode=disable"

REDIS_ADDR=
REDIS_DB=0
REDIS_PASSWORD=

LEGACY_DM_BASE_URL=
LEGACY_DM_REFRESH_TOKEN=

APP_SWAGGER_DISCOVERY_ON_START=false

# monitoring: external Prometheus / log-store for the admin charts (all optional)
PROMETHEUS_URL=
METRICS_NAMESPACE=company

# logs provider: loki wins if both are configured
LOKI_URL=
LOKI_SELECTOR={app="ruto-gateway"}
LOKI_ORG_ID=

GRAYLOG_URL=
GRAYLOG_API_TOKEN=
GRAYLOG_STREAM_ID=
GRAYLOG_QUERY=

# built-in MCP server for AI agents (api-key auth, own port; see docs/mcp-server.md)
MCP_ENABLED=false
MCP_PORT=5060

# change requests proposed over MCP: undecided ones expire after the TTL,
# closed ones are deleted after the retention
CHANGE_REQUEST_TTL=168h
CHANGE_REQUEST_RETENTION=720h
CHANGE_REQUEST_MAX_PENDING_PER_KEY=20
