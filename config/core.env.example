DEBUG=true
LOG_LEVEL=info

SYSTEM_PORT=3003

GRPC_PORT=5050
HTTP_PORT=80
HTTP_CORS=true

ADMIN_JWT_SECRET=change_me_secret

PG_DSN="postgres://user:password@localhost:5432/database?sslmode=disable"

REDIS_ADDR=
REDIS_DB=0
REDIS_PASSWORD=

LEGACY_DM_BASE_URL=
LEGACY_DM_REFRESH_TOKEN=

APP_SWAGGER_DISCOVERY_ON_START=false

# monitoring: external Prometheus / log-store for the admin charts (all optional)
PROMETHEUS_URL=
METRICS_NAMESPACE=company

# logs provider: loki wins if both are configured
LOKI_URL=
LOKI_SELECTOR={app="ruto-gateway"}
LOKI_ORG_ID=

GRAYLOG_URL=
GRAYLOG_API_TOKEN=
GRAYLOG_STREAM_ID=
GRAYLOG_QUERY=

# built-in MCP server for AI agents (api-key auth, own port; see docs/mcp-server.md)
MCP_ENABLED=false
MCP_PORT=5060

# whom the MCP port believes about the client address in its logs, as for the
# gateway: forwarding headers from TRUSTED_PROXY_ADDRESSES, Cf-Connecting-Ip from
# Cloudflare's networks (refreshed from the URL, 0 keeps the built-in list)
TRUSTED_PROXY_ADDRESSES=
CLOUDFLARE_IPS_URL=https://api.cloudflare.com/client/v4/ips
CLOUDFLARE_IPS_REFRESH=24h

# OAuth for MCP clients that connect by URL (Claude connectors); api keys keep
# working alongside. MCP_PUBLIC_URL: the MCP server as clients see it;
# MCP_OAUTH_ADMIN_URL: the admin UI, where the consent page opens.
MCP_OAUTH_ENABLED=false
MCP_PUBLIC_URL=
MCP_OAUTH_ADMIN_URL=
MCP_OAUTH_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback,http://localhost,http://127.0.0.1
MCP_OAUTH_ACCESS_TTL=1h
MCP_OAUTH_REFRESH_TTL=720h

# change requests proposed over MCP: undecided ones expire after the TTL,
# closed ones are deleted after the retention
CHANGE_REQUEST_TTL=168h
CHANGE_REQUEST_RETENTION=720h
CHANGE_REQUEST_MAX_PENDING_PER_KEY=20
